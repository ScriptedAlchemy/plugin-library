{
  "name": "plugin-library",
  "version": "0.3.0",
  "builder": {
    "tool": "agent-bundle",
    "status": "not-available-in-this-build-environment",
    "fallback": "hand-authored-compatible-artifacts"
  },
  "consumerInstall": {
    "selfContained": true,
    "requiresAgentBundleCli": false,
    "paths": [
      "node ./install.mjs",
      "Cursor add-plugin https://github.com/ScriptedAlchemy/plugin-library",
      "official Marketplace once published"
    ]
  },
  "artifacts": [
    "install.mjs",
    "INSTALL.md",
    "plugin.json",
    ".cursor-plugin/plugin.json",
    ".cursor-plugin/marketplace.json",
    ".claude-plugin/plugin.json",
    ".claude-plugin/marketplace.json",
    ".codex-plugin/plugin.json"
  ]
}
